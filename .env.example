# Runtime
NODE_ENV=development
PORT=5000
TRUST_PROXY=false

# Required secrets and infrastructure
MONGO_URL=mongodb://127.0.0.1:27017/full_product_management
SECRET_JWT=replace-with-a-random-secret-of-at-least-32-characters

# Comma-separated browser origins, or * for public non-credentialed APIs
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Account links and transactional email (console, mock, or resend)
APP_URL=http://localhost:5000
EMAIL_PROVIDER=console
EMAIL_FROM=onboarding@resend.dev
# RESEND_API_KEY=required-when-EMAIL_PROVIDER=resend

# Billing: mock for development/tests or chargily in production
BILLING_PROVIDER=mock
# CHARGILY_SECRET_KEY=required-when-BILLING_PROVIDER=chargily
# CHARGILY_WEBHOOK_SECRET=required-when-BILLING_PROVIDER=chargily
CHARGILY_BASE_URL=https://pay.chargily.net/api/v2

# Structured logging: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Global and stricter authentication rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
